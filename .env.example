# --- Nube (opcional pero recomendada) -----------------------------------
# Sin estas dos, la app guarda sólo en el navegador, como antes.
# Se sacan de Supabase → Project Settings → API.
# OJO: se incrustan al compilar, así que hay que definirlas en Vercel ANTES
# de desplegar; si se añaden después, hay que volver a desplegar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Con estas dos, `npm run comprobar:nube` entra de verdad en la cuenta y
# comprueba también las fotos y que las políticas dejen leer. Sólo sirven
# para esa comprobación: la app no las usa nunca.
COMPROBAR_EMAIL=
COMPROBAR_PASSWORD=

# --- Google Calendar (opcional) ------------------------------------------
# Sin estas variables, la sección de Tareas funciona igual: guarda los
# recados en el móvil y en la cuenta de casa, pero no los manda a ningún
# calendario ni puede avisar por su cuenta.
#
# Se sacan de Google Cloud Console → APIs y servicios → Credenciales →
# «ID de cliente de OAuth» de tipo «Aplicación web». Hay que habilitar
# además la Google Calendar API en «APIs y servicios → Biblioteca».
#
# En «URIs de redirección autorizados» hay que poner, tal cual:
#   http://localhost:3000/api/calendario/callback
#   https://TU-DOMINIO/api/calendario/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sólo si la de vuelta no se puede deducir del dominio (proxys, dominios
# propios). Debe coincidir letra por letra con la declarada en Google.
# GOOGLE_REDIRECT_URI=https://tu-dominio/api/calendario/callback

# Clave de servicio de Supabase: la usan las rutas de /api/calendario para
# guardar el permiso de Google. NO lleva NEXT_PUBLIC_: si acabara en el
# navegador daría acceso a todo, saltándose las políticas de fila.
# Se saca de Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Economía: las cifras de arranque de las libretas ---------------------
# Este repositorio es público, así que en el código no entra ninguna cantidad
# de nadie: el código trae la forma —cómo se llaman los conceptos y cómo se
# suman— y el aparato trae los números, aquí.
#
# Sólo se usa al estrenar la libreta y al pulsar «Rellenar con la hoja»: a
# partir de ahí mandan las cifras tecleadas en la app, que es lo editable.
# Sin esta variable, la sección se estrena a cero como siempre.
#
# Es un JSON en una sola línea, con las llaves de concepto de `lib/finance.ts`.
# Una cifra suelta es la principal; un par `[a, b]` añade la segunda columna:
# en gastos, previsión y real; en ingresos, mínimo y máximo.
#
# {"months":12,"payMonths":10,"holidays":0,
#  "goals":{"withdrawal":4,"cushion":12,"realReturn":4},
#  "amounts":{"gastos":{"casa":[0,0],"comida":[0,0]},"cuentas":{"unicaja":0}}}
#
# OJO: lleva NEXT_PUBLIC_, así que se incrusta al compilar. En Vercel hay que
# ponerla ANTES de desplegar, y quien tenga acceso al panel la puede leer.
NEXT_PUBLIC_ECONOMIA_SEED=
